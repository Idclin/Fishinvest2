rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solid fallback - lock everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Profiles: users can read their own profiles; backend and simulators can write
    match /users/{telegram_id} {
      allow read, write: if true;
    }

    // Fish holdings: transparent read and safe writes for tracking fish
    match /fish_holdings/{holding_id} {
      allow read, write: if true;
    }

    // Transactions: ledger records
    match /transactions/{transaction_id} {
      allow read, write: if true;
    }

    // Referrals: tracking user invite bonus trees
    match /referrals/{referral_id} {
      allow read, write: if true;
    }

    // Withdrawals: cash payout ledger logs
    match /withdrawals/{withdrawal_id} {
      allow read, write: if true;
    }

    // Admins logs and specs
    match /admins/{admin_email} {
      allow read, write: if true;
    }

    // Dynamic fish specs
    match /fish_market_specs/{fish_id} {
      allow read, write: if true;
    }
  }
}
